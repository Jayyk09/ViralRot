# xAI Grok (dialogue generation and visual planning)
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.5

# SerpApi image discovery and signed review candidates
SERPAPI_API_KEY=your_serpapi_api_key
# Generate a random value with at least 32 bytes; keep stable across backend restarts.
IMAGE_CANDIDATE_SIGNING_KEY=replace_with_a_random_32_byte_or_longer_secret

# Provider timeouts, deadlines, and retries
GROK_DIALOGUE_TIMEOUT_SECONDS=120
GROK_VISUAL_PLANNING_TIMEOUT_SECONDS=90
SERPAPI_SEARCH_TIMEOUT_SECONDS=20
IMAGE_FETCH_TIMEOUT_SECONDS=15
DIALOGUE_GENERATION_DEADLINE_SECONDS=300
VISUAL_PLANNING_DEADLINE_SECONDS=180
AUTOMATIC_VISUAL_GENERATION_DEADLINE_SECONDS=600
REVIEW_VISUAL_GENERATION_DEADLINE_SECONDS=600
FAILED_SLOT_RETRY_DEADLINE_SECONDS=300
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5
PROVIDER_RETRY_MAX_DELAY_SECONDS=30

# MiniMax TTS (for audio generation)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
MINIMAX_PETER_VOICE=moss_audio_e848d74f-eff7-11f0-b849-2ee1aa6f659f
MINIMAX_STEWIE_VOICE=moss_audio_7225939f-eff7-11f0-b024-56bf9f9087e2

# Database
# For local development with Docker:
DATABASE_URL=postgresql://emory_hacks_user:devpassword@localhost:5432/emory_hacks_db
# For production with Neon:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Reusable background catalog (MP4s at the bucket root by default).
R2_BACKGROUND_BUCKET_NAME=your_background_bucket_name
# User projects, narration, overlays, and generated exports.
R2_PROJECT_MEDIA_BUCKET_NAME=your_project_media_bucket_name
# If background MP4s live below a prefix instead of at bucket root:
# R2_BACKGROUND_PREFIX=backgrounds/

# Optional generated audio fixtures for /create2 development only.
ENABLE_DEV_FIXTURES=false

# For local development without R2:
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=storage/videos
